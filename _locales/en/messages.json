    "message": "Spam reported successfully!"
  },
  "spamReportError": {
    "message": "Error while reporting spam."
  },
  "blacklistAddSuccess": {
    "message": "Address added to blacklist successfully!"
  },
  "blacklistAddError": {
    "message": "Error while adding to blacklist."
  },
  "blacklistDomainAddSuccess": {
    "message": "Domain added to blacklist successfully!"
  },
  "errorOccurred": {
    "message": "Error: $MESSAGE$",
    "placeholders": {
      "message": { "content": "$1" }
    }
  },
